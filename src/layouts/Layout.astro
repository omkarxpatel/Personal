---
import "../styles/global.css";
import { site as profile, about, education, work, skills } from "../data/site.ts";

interface Props {
  title?: string;
  description?: string;
}
const {
  title = "Omkar Patel",
  description = "cs @ northeastern · ai eng intern @ rysun labs · founding eng @ kinoraa — portfolio of omkar patel",
} = Astro.props;

const base = (Astro.site?.origin ?? "https://omkarpatel.xyz").replace(/\/$/, "");

// schema.org/Person for machine readers. Built from src/data/site.ts so it
// tracks the resume automatically. Phone is deliberately omitted — it lives
// in the PDF, but there's no reason to hand it to scrapers in structured form.
const personLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: profile.name,
  alternateName: profile.handle,
  url: base,
  email: `mailto:${profile.email}`,
  description: about,
  jobTitle: work.filter((w) => w.dates.includes("present")).map((w) => w.role),
  worksFor: work
    .filter((w) => w.dates.includes("present"))
    .map((w) => ({ "@type": "Organization", name: w.company })),
  alumniOf: education.map((e) => ({
    "@type": "EducationalOrganization",
    name: e.school,
  })),
  knowsAbout: [
    ...skills.languages,
    ...skills.web,
    ...skills.ai,
    ...skills.infra,
  ],
  sameAs: [profile.github, profile.linkedin],
};
---
<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="Plain-text version for LLMs" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="https://omkarvpatel.netlify.app/og.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://omkarvpatel.netlify.app/og.png" />

    <title>{title}</title>

    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(personLd)}
    ></script>

    <script
      is:inline
      data-goatcounter="https://omkarxpatel.goatcounter.com/count"
      async
      src="//gc.zgo.at/count.js"></script>

    <script is:inline>
      // set theme before paint to avoid flash
      (function () {
        try {
          const stored = localStorage.getItem("theme");
          const theme = stored === "light" || stored === "dark" ? stored : "dark";
          document.documentElement.setAttribute("data-theme", theme);
        } catch (e) {}
      })();
    </script>
  </head>

  <body class="min-h-dvh py-6 sm:py-12 px-4 sm:px-6">
    <slot />
  </body>
</html>
