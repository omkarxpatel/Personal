---
// figlet "Standard" font: omkar
const lines = [
  "                _              ",
  "  ___  _ __ ___ | | ____ _ _ __ ",
  " / _ \\| '_ ` _ \\| |/ / _` | '__|",
  "| (_) | | | | | |   < (_| | |   ",
  " \\___/|_| |_| |_|_|\\_\\__,_|_|   ",
];
const sig = lines.join("\n");
---
<pre
  aria-label="omkar"
  class="ascii-sig text-[color:var(--color-success)] text-[10px] sm:text-xs leading-[1.15] mb-6 select-none whitespace-pre overflow-x-auto"
>{sig}</pre>
