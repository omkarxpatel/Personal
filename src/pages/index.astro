---
import Layout from "../layouts/Layout.astro";
import Terminal from "../components/Terminal.astro";
import { site } from "../data/site.ts";

const quickLinks = [
  { label: "resume", href: site.resume },
  { label: "github", href: site.github },
  { label: "linkedin", href: site.linkedin },
  { label: "email", href: `mailto:${site.email}` },
];
---
<Layout>
  <Terminal />

  <nav
    aria-label="quick links"
    class="mx-auto max-w-3xl mt-5 px-2 text-xs sm:text-sm flex items-center justify-center gap-3 text-[color:var(--color-dim)]"
  >
    {quickLinks.map((l, i) => (
      <>
        {i > 0 && <span aria-hidden="true">·</span>}
        <a
          href={l.href}
          target="_blank"
          rel="noopener"
          class="text-[color:var(--color-accent)] hover:underline"
        >{l.label}</a>
      </>
    ))}
  </nav>

  <footer class="mx-auto max-w-3xl mt-6 px-2 text-xs text-[color:var(--color-muted)] flex items-center justify-between">
    <span>built with astro · last updated jul 2026</span>
    <a href="https://github.com/omkarxpatel/Personal" target="_blank" rel="noopener" class="hover:text-[color:var(--color-text)]">view source</a>
  </footer>
</Layout>
